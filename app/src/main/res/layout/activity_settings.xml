<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 中心圆球：品牌色径向渐变弧度外观，点击有弹跳反馈 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/viewSphere"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_sphere"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="默认提示样式（ToastCenter 出口使用）"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/radioNative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="原生 Toast（系统样式，兼容性最好）" />

                <RadioButton
                    android:id="@+id/radioCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义 Toast（图标 + 圆角半透明）" />

                <RadioButton
                    android:id="@+id/radioModern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="现代化 Snackbar（可交互，推荐）" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="提示权限管理（关闭后该类提示完全静默）"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchNative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="允许原生 Toast" />

            <Switch
                android:id="@+id/switchCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许自定义 Toast" />

            <Switch
                android:id="@+id/switchModern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许现代化 Snackbar" />

            <Switch
                android:id="@+id/switchDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许模态对话框提示" />

            <Switch
                android:id="@+id/switchNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许系统通知（后台提示）" />

            <Switch
                android:id="@+id/switchTrace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="记录生命周期回调日志" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@color/bg_chip"
                android:padding="12dp"
                android:lineSpacingMultiplier="1.4"
                android:text="说明：这些偏好通过 SharedPreferences 持久化，属于「少量键值型数据」，不需要数据库。全部关闭提示样式时，ToastCenter 会按 现代化→自定义→原生 顺序自动降级，保证关键反馈不丢。"
                android:textColor="@color/brand_primary_dark"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
