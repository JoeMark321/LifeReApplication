<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.LifeRe.Popup" />

    <FrameLayout
        android:id="@+id/containerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      列表演演三的自定义底部 tab 行（全自定义，不依赖 BottomNavigationView）：
      悬浮白底圆角条 + 三个纯文字 tab（无图标干扰）：
      选中 = 品牌蓝胶囊 + 白字；未选 = 透明 + 灰字。状态用 android:selected 驱动。
    -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/tabLinear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:gravity="center"
            android:text="线性列表"
            android:textColor="@color/tab_text_tint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:gravity="center"
            android:text="双列网格"
            android:textColor="@color/tab_text_tint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabGrid3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:gravity="center"
            android:text="三列网格"
            android:textColor="@color/tab_text_tint"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
