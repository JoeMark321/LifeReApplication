<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      公共核心主题（日/夜共用）：
      全面屏适配采用「跨版本自动实现」策略——
      ① Android 15+（API 35+）：系统强制 edge-to-edge，状态栏透明，
         空间由 BaseMenuActivity 中的 WindowInsets 监听自动腾出（代码层）；
      ② Android 11~14：statusBarColor 直接着品牌蓝，系统默认 decorFits，
         与 ① 视觉完全一致，无需代码分支；
      ③ windowBackground = 页面底色：edge-to-edge 时手势条区域/未被布局
         覆盖处露出统一底色，不会出现刺眼黑条。
    -->
    <style name="Theme.LifeRe.Core" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <!-- 刘海屏：内容延伸进刘海区域，配合 insets 监听不遮挡关键内容 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- 现代化滚动条：圆角胶囊拇指，统一所有列表观感 -->
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarSize">@dimen/scrollbar_size</item>
        <item name="android:scrollbarDefaultDelayBeforeFade">800</item>
        <item name="android:scrollbarFadeDuration">300</item>
        <!-- 右上角下拉菜单：白色圆角卡片（替换默认灰底），AppCompat popupMenuBackground -->
        <item name="popupMenuBackground">@drawable/bg_popup_menu</item>
        <!--
          菜单条目文字色必须在 ACTIVITY 主题层钉死：
          溢出菜单的条目 View 由 Activity/Window 上下文创建（popupTheme 只管弹窗背景），
          Material3 主题下其文字被解析为白色 → 白底白字"空面板"。
          textAppearance 两项 + textColorPrimary 三保险。
        -->
        <item name="textAppearanceSmallPopupMenu">@style/LifeRe.PopupMenu.Text</item>
        <item name="textAppearanceLargePopupMenu">@style/LifeRe.PopupMenu.Text</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!--
      下拉菜单专用 overlay（Toolbar popupTheme 引用）：
      背景 = 白色圆角卡；文字 = 深色。必须在 overlay 里显式钉死文字色，
      否则 Material3 主题下 popup 文字会被解析成白色 → 白底白字"空面板"。
    -->
    <style name="ThemeOverlay.LifeRe.Popup" parent="ThemeOverlay.AppCompat.Light">
        <item name="popupMenuBackground">@drawable/bg_popup_menu</item>
        <item name="popupMenuStyle">@style/LifeRe.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/LifeRe.PopupMenu.Text</item>
        <item name="textAppearanceLargePopupMenu">@style/LifeRe.PopupMenu.Text</item>
        <!-- 强力兜底：菜单条目文字色由 popup context 的 textColorPrimary 决定，
             Material3 主题下必须显式钉死，否则白底白字 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="LifeRe.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="LifeRe.PopupMenu.Text" parent="TextAppearance.AppCompat.Widget.PopupMenu.Small">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Base application theme（日间） -->
    <style name="Base.Theme.LifeReApplication" parent="Theme.LifeRe.Core" />

    <style name="Theme.LifeReApplication" parent="Base.Theme.LifeReApplication" />

    <!--
      开屏 Splash：冷启动首帧即品牌蓝图 + Miku 立绘图标（替代白屏）。
      Android 12+ 由系统 SplashScreen 渲染；低版本由 core-splashscreen 兼容模拟。
      系统会把 icon 裁切为圆形展示。
    -->
    <style name="Theme.LifeRe.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeReApplication</item>
    </style>

    <!-- 对话框风格 Activity：半透明，宿主只 onPause 不 onStop -->
    <style name="Theme.LifeReApplication.Transparent" parent="Theme.LifeReApplication">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
